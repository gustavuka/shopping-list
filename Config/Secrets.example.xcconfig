// Copy to Secrets.xcconfig and fill in. Publishable keys only — never the secret/service-role key.
// Phones (iphoneos) use the cloud project; simulators use the local stack from `supabase start`.
// Cloud: `supabase projects api-keys` (type "publishable"). Local: `supabase status`.

SUPABASE_URL[sdk=iphoneos*] = https:/$()/<project-ref>.supabase.co
SUPABASE_KEY[sdk=iphoneos*] = sb_publishable_...

SUPABASE_URL[sdk=iphonesimulator*] = http:/$()/127.0.0.1:54321
SUPABASE_KEY[sdk=iphonesimulator*] = sb_publishable_...
