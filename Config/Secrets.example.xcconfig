// Copy to Secrets.xcconfig and fill in. Use the *publishable* (anon) key only — never the secret/service-role key.
// Local values come from `supabase status`; cloud values from the Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_KEY = sb_publishable_...
