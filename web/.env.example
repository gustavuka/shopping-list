# Copy to .env.local and fill in. Publishable key only — never the secret/service-role key.
# Local stack (`supabase start`, then `supabase status`) or the cloud project (`supabase projects api-keys`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_KEY=sb_publishable_...
# Optional: Cloudflare Turnstile site key. Set it only after enabling captcha in the Supabase project
# (Authentication → Attack Protection), and only once the iOS app also sends tokens. See docs/setup.md.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
